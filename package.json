{
  "name": "youtube-gamepad",
  "version": "0.2.0",
  "private": true,
  "description": "Gamepad navigation and playback controls for YouTube",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "styles": "node scripts/build-styles.mjs",
    "check": "node scripts/check.mjs",
    "check:modules": "node scripts/check.mjs --modules-only",
    "test": "node scripts/test.mjs unit",
    "test:browser": "node scripts/test.mjs browser",
    "test:extension": "node scripts/test.mjs extension",
    "test:youtube": "node scripts/test.mjs live",
    "verify": "node scripts/check.mjs && node scripts/test.mjs all",
    "build": "node scripts/build-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "typescript-vue": "npm:typescript@^5.9.3",
    "vite": "8.3.3",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "youtubei.js": "18.1.0"
  }
}
