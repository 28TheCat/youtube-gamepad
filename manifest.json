{
  "manifest_version": 3,
  "name": "YouTube Gamepad",
  "version": "0.2.0",
  "description": "Browse YouTube and control video playback with a gamepad.",
  "icons": {
    "128": "assets/icons/gamepad-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/settings/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/ui/theme.css",
        "src/app/browse.css",
        "src/app/theater.css"
      ],
      "js": [
        "src/shared/actions.js",
        "src/input/bindings.js",
        "src/shared/runtime.js",
        "src/diagnostics/diagnostics.js",
        "src/app/route-state.js",
        "src/app/state-machine.js",
        "src/ui/styles.js",
        "src/input/controller-style.js",
        "src/input/gamepad.js",
        "src/navigation/navigation.js",
        "src/navigation/focus.js",
        "src/navigation/core.js",
        "src/search/keyboard.js",
        "src/search/pinyin-data.js",
        "src/search/pinyin.js",
        "src/search/search.js",
        "src/ui/menu.js",
        "src/ui/watch-view.js",
        "src/ui/watch-panels.js",
        "src/playback/watch.js",
        "src/app/browse.js",
        "src/sites/youtube.js",
        "src/app/route-controller.js",
        "src/app/coordinator.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/actions.js",
        "src/input/bindings.js",
        "src/diagnostics/diagnostics-store.js",
        "src/settings/inline-settings.js",
        "src/app/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
