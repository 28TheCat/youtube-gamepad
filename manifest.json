{
  "manifest_version": 3,
  "name": "YouTube Gamepad",
  "version": "0.2.0",
  "description": "Browse YouTube and control video playback with a gamepad.",
  "icons": {
    "128": "assets/icons/gamepad-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "bundles/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/settings/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bundles/early.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/ui/theme.css",
        "src/app/browse.css",
        "src/app/theater.css"
      ],
      "js": [
        "bundles/main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bundles/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
